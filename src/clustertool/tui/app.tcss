Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

#jobs {
    width: 2fr;
    height: 100%;
    border: round $panel-lighten-2;
    border-title-align: left;
    padding: 0 1;
}

#storage {
    width: 1fr;
    min-width: 24;
    height: 100%;
    border: round $panel-lighten-2;
    border-title-align: left;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#storage-body,
#standing-body {
    height: auto;
    width: 100%;
}

#standing {
    height: 7;
    max-height: 40%;
    scrollbar-size-vertical: 1;
    border: round $panel-lighten-2;
    border-title-align: left;
    padding: 0 1;
}

#jobs-table {
    height: 1fr;
    min-height: 2;
    overflow-x: hidden;
}

#jobs-detail {
    height: auto;
    max-height: 8;
    padding: 1 1 0 1;
    color: $text-muted;
    border-top: dashed $panel-lighten-2;
}

#jobs:focus-within,
#storage:focus,
#standing:focus {
    border: round $accent;
}

#status {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

#help {
    align: center middle;
}

#help-body {
    width: auto;
    max-width: 90%;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
